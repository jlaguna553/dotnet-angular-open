---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import SidebarNav from '../components/SidebarNav.astro';
const { frontmatter } = Astro.props;
---
<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <Header />
  <div class="mx-auto flex max-w-[1500px] gap-10 px-5 py-8 sm:px-8 lg:py-12">
    <SidebarNav />
    <main class="min-w-0 max-w-4xl flex-1">
      <div class="mb-10 border-b border-ink/10 pb-8">
        <div class="mb-4 flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-coral"><span>Parte {String(frontmatter.part).padStart(2, '0')}</span><span class="text-ink/20">/</span><span class="text-ink/45">{frontmatter.duration ?? 'A tu ritmo'}</span></div>
        <h1 class="max-w-3xl font-display text-4xl font-bold tracking-tight text-ink sm:text-6xl">{frontmatter.title}</h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-ink/65">{frontmatter.description}</p>
        <div class="mt-5 flex flex-wrap gap-2">{frontmatter.tags?.map((tag: string) => <span class="rounded-full bg-ink/5 px-3 py-1 text-xs font-semibold text-ink/55">#{tag}</span>)}</div>
      </div>
      <article class="prose prose-lg max-w-none prose-headings:font-display prose-headings:tracking-tight prose-headings:text-ink prose-p:text-ink/75 prose-a:text-coral prose-a:no-underline hover:prose-a:underline prose-code:text-coral prose-pre:bg-transparent prose-strong:text-ink">
        <slot />
      </article>
    </main>
    <aside class="hidden w-52 shrink-0 xl:block">
      <div class="sticky top-28 border-l border-ink/10 pl-5 text-xs text-ink/50">
        <p class="mb-3 font-bold uppercase tracking-[0.15em] text-ink/35">En esta parte</p>
        <nav id="toc" class="space-y-2"></nav>
      </div>
    </aside>
  </div>
</BaseLayout>
<script>
  const toc = document.querySelector('#toc');
  document.querySelectorAll('article h2, article h3').forEach((heading) => {
    if (!heading.id || !toc) return;
    const link = document.createElement('a');
    link.href = `#${heading.id}`;
    link.textContent = heading.textContent;
    link.className = heading.tagName === 'H3' ? 'block pl-3 leading-5' : 'block font-semibold leading-5';
    toc.append(link);
  });
</script>
